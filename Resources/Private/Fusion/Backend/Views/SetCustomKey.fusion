
prototype(Sitegeist.LostInTranslation:Views.SetCustomKey) < prototype(Neos.Fusion:Component) {
    renderer = afx`
        <legend>{I18n.translate('setCustomKey.heading', 'Store custom DeepL API-key', [], 'Modules', 'Sitegeist.LostInTranslation')}</legend>

        <Neos.Fusion.Form:Form
            form.target.action="storeCustomKey"
        >

            <div class="neos-control-group">
                <label class="neos-control-label" for="key">{I18n.translate('setCustomKey.label', 'DeepL Api-key', [], 'Modules', 'Sitegeist.LostInTranslation')}</label>
                <div class="neos-controls neos-controls-row">
                    <Neos.Fusion.Form:Input field.name="key" attributes.class="neos-span12" />
                </div>
            </div>

            <div class="neos-footer">
                <Neos.Fusion:Link.Action href.action="index" class="neos-button">{I18n.translate('action.back', 'Back', [], 'Modules', 'Sitegeist.LostInTranslation')}</Neos.Fusion:Link.Action>
                <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-primary">{I18n.translate('setCustomKey.save', 'Save Key', [], 'Modules', 'Sitegeist.LostInTranslation')}</Neos.Fusion.Form:Button>
            </div>

        </Neos.Fusion.Form:Form>
    `
}
