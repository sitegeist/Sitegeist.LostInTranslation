prototype(Sitegeist.LostInTranslation:Views.SynchronizationStatus) < prototype(Neos.Fusion:Component) {
  renderer = afx`
    <div class="neos-content neos-container-fluid">
        <Neos.Fusion:Link.Action href.action="index" class="neos-button">
            <i class="fas fa-language"></i>&nbsp;Glossaries
        </Neos.Fusion:Link.Action>
        &nbsp;
        <Neos.Fusion:Link.Action href.action="showStatus" class="neos-button">
            <i class="fas fa-cog"></i>&nbsp;API-Status
        </Neos.Fusion:Link.Action>
        &nbsp;
        <Neos.Fusion:Link.Action href.action="synchronizationStatus" class="neos-button neos-active">
            <i class="fas fa-sync"></i>&nbsp;Synchronization
        </Neos.Fusion:Link.Action>
    </div>

    <legend>Synchronization</legend>

    <div @if={!projectionStatus.isReady} class="neos-error">
        <p>
            <i class="fas fa-exclamation-triangle" style="color:#ff460d;"></i>
            &nbsp;<strong>{projectionStatus.summary}</strong>
        </p>
        <p @if={projectionStatus.hint}>{projectionStatus.hint}</p>
    </div>

    <div @if={projectionStatus.isReady && !rules}>
        <p>No synchronization rules are configured. Add rules under
          <code>Sitegeist.LostInTranslation.nodeTranslation.synchronization</code>.</p>
    </div>

    <Neos.Fusion:Fragment @if={projectionStatus.isReady && rules}>
      <table class="neos-table">
        <thead>
        <tr>
          <th>Source</th>
          <th>Target</th>
          <th>Scope</th>
          <th>Mode</th>
          <th>Status</th>
          <th></th>
        </tr>
        </thead>
        <tbody>
        <Neos.Fusion:Loop items={rules} itemName="rule">
          <tr>
            <td>{rule.sourceWorkspaceName} / {rule.sourceDimension}</td>
            <td>{rule.targetWorkspaceName} / {rule.targetDimension}</td>
            <td>{rule.scope}</td>
            <td>{rule.mode}</td>
            <td>
              <Neos.Fusion:Fragment @if={!rule.targetWorkspaceExists}>
                <i class="fas fa-times-circle" style="color:#ff460d;"></i>
                &nbsp;target workspace does not exist
              </Neos.Fusion:Fragment>
              <Neos.Fusion:Fragment @if={rule.targetWorkspaceExists}>
                <i class="fas fa-check-circle" style="color:green;" @if={rule.pendingCount < 1}></i>
                <i class="fas fa-exclamation-triangle" style="color:#ffae00;" @if={rule.pendingCount > 0}></i>
                &nbsp;{rule.pendingCount > 0 ? rule.pendingCount + ' translation(s) pending' : 'up to date'}
              </Neos.Fusion:Fragment>
            </td>
            <td class="neos-action">
              <!-- On submit, turn the icon into a spinner and (on the next tick, so the form still submits) disable
                   every sync button to prevent double-triggering during the blocking request. The page reloads when the
                   synchronous sync finishes, which resets the buttons. -->
              <!-- ruleIndex is passed as a target argument (in the action URL), not a Neos.Fusion.Form:Hidden field:
                   the Input prototype coalesces its stringified value with the Eel-or operator, and index 0 stringifies
                   to the Eel-falsy zero, which would drop the value and make ruleIndex arrive empty for the first rule. -->
              <Neos.Fusion.Form:Form form.target.action="synchronizeRule" form.target.arguments.ruleIndex={rule.index} attributes.class="neos-inline neos-pull-right" attributes.onsubmit="var i = this.querySelector('button i'); if (i) i.className = 'fas fa-spinner fa-spin'; setTimeout(() => document.querySelectorAll('.js-sync-button').forEach(b => b.disabled = true), 0);">
                <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-primary js-sync-button">
                  <i class="fas fa-sync"></i> Sync now
                </Neos.Fusion.Form:Button>
              </Neos.Fusion.Form:Form>
            </td>
          </tr>
        </Neos.Fusion:Loop>
        </tbody>
      </table>

      <Neos.Fusion.Form:Form form.target.action="synchronizeAllRules" attributes.class="neos-inline" attributes.onsubmit="var i = this.querySelector('button i'); if (i) i.className = 'fas fa-spinner fa-spin'; setTimeout(() => document.querySelectorAll('.js-sync-button').forEach(b => b.disabled = true), 0);">
        <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-primary js-sync-button">
          <i class="fas fa-sync"></i> Sync all rules ({pendingTotal} pending)
        </Neos.Fusion.Form:Button>
      </Neos.Fusion.Form:Form>
    </Neos.Fusion:Fragment>
  `
}
