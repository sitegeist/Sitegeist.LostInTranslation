prototype(Sitegeist.LostInTranslation:Views.ShowGlossary) < prototype(Neos.Fusion:Component) {
    renderer = afx`
        <legend>{I18n.translate('showGlossary.heading', 'Glossary {0}', [glossary.label], 'Modules', 'Sitegeist.LostInTranslation')}</legend>

        <table class="neos-table">
            <tbody>
            <tr>
                <td>{I18n.translate('showGlossary.modified', 'Modified', [], 'Modules', 'Sitegeist.LostInTranslation')}</td>
                <td>{Date.format(glossary.modificationDate, 'd.m.Y H:i')}</td>
            </tr>
            <tr>
                <td>{I18n.translate('showGlossary.synchronized', 'Synchronized', [], 'Modules', 'Sitegeist.LostInTranslation')}</td>
                <td>{glossary.synchronizationDate ? Date.format(glossary.synchronizationDate, 'd.m.Y H:i') : '-'}</td>
            </tr>
            <tr>
                <td>{I18n.translate('showGlossary.remoteId', 'Remote ID', [], 'Modules', 'Sitegeist.LostInTranslation')}</td>
                <td>{glossary.synchronizationIdentifier}</td>
            </tr>
            <tr>
                <td>{I18n.translate('showGlossary.status', 'Status', [], 'Modules', 'Sitegeist.LostInTranslation')}</td>
                <td>
                    <i class="fas fa-check-circle" style="color:green;" @if={glossary.upToDate}></i>
                    <i class="fas fa-exclamation-triangle" style="color:red;" @if={!glossary.upToDate}></i>
                    &nbsp;{glossary.upToDate ? I18n.translate('status.upToDate', 'up to date', [], 'Modules', 'Sitegeist.LostInTranslation') : I18n.translate('status.outdated', 'outdated', [], 'Modules', 'Sitegeist.LostInTranslation')}
                </td>
            </tr>
            </tbody>
        </table>

        <Neos.Fusion.Form:Form form.target.action="uploadGlossary">
            <Neos.Fusion.Form:Hidden field.name="glossary" field.value={glossary}/>
            <button class="neos-button neos-button-success" title={I18n.translate('glossaries.upload.title', 'Upload glossary', [], 'Modules', 'Sitegeist.LostInTranslation')} data-toggle="modal"
                    href={"#uploadGlossary" + iterator.index}>
                <i class="fas fa-upload"></i> {I18n.translate('glossaries.upload', 'Upload Glossary', [], 'Modules', 'Sitegeist.LostInTranslation')}
            </button>
        </Neos.Fusion.Form:Form>

        <legend>{I18n.translate('showGlossary.entries', 'Entries', [], 'Modules', 'Sitegeist.LostInTranslation')}</legend>

        <p @if={!glossary.entries}>{I18n.translate('showGlossary.noEntries', 'No entries yet. Please create one.', [], 'Modules', 'Sitegeist.LostInTranslation')}</p>

        <table class="neos-table" @if={glossary.entries}>
            <thead>
            <tr>
                <th>{I18n.translate('showGlossary.col.source', 'Source - {0}', [glossary.sourceLanguageKey], 'Modules', 'Sitegeist.LostInTranslation')}</th>
                <th>{I18n.translate('showGlossary.col.target', 'Target - {0}', [glossary.targetLanguageKey], 'Modules', 'Sitegeist.LostInTranslation')}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            <Neos.Fusion:Loop items={glossary.entries} itemName="entry">
                <tr>
                    <td>
                        {entry.sourceText}
                    </td>
                    <td>
                        {entry.targetText}
                    </td>
                    <td class="neos-action">
                        <button class="neos-button neos-button-danger neos-pull-right" title={I18n.translate('entry.delete', 'Delete Entry', [], 'Modules', 'Sitegeist.LostInTranslation')}
                                data-toggle="modal" href={"#deleteEntry" + iterator.index}>
                            <i class="fas fa-trash"></i> {I18n.translate('entry.delete', 'Delete Entry', [], 'Modules', 'Sitegeist.LostInTranslation')}
                        </button>
                        <Neos.Fusion:Link.Action href.action="editGlossaryEntry" href.arguments.entry={entry} class="neos-button neos-pull-right">
                            <i class="fas fa-edit"></i> {I18n.translate('entry.edit', 'Edit Entry', [], 'Modules', 'Sitegeist.LostInTranslation')}
                        </Neos.Fusion:Link.Action>

                        <div class="neos-hide" id={"deleteEntry" + iterator.index}>
                            <div class="neos-modal">
                                <div class="neos-modal-header">
                                    <button type="button" class="neos-close neos-button" data-dismiss="modal"></button>
                                    <div class="neos-header">{I18n.translate('entry.delete.confirmHeader', 'Delete Entry {0}', [entry.sourceText], 'Modules', 'Sitegeist.LostInTranslation')}</div>
                                </div>
                                <div class="neos-modal-footer">
                                    <a href="#" class="neos-button" data-dismiss="modal">{I18n.translate('action.cancel', 'Cancel', [], 'Modules', 'Sitegeist.LostInTranslation')}</a>
                                    <Neos.Fusion.Form:Form
                                        form.target.action="deleteGlossaryEntry"
                                        attributes.class="neos-inline"
                                    >
                                        <Neos.Fusion.Form:Hidden field.name="entry" field.value={entry}/>
                                        <Neos.Fusion.Form:Button attributes.class="neos-button neos-button-danger">
                                            {I18n.translate('entry.delete', 'Delete Entry', [], 'Modules', 'Sitegeist.LostInTranslation')}
                                        </Neos.Fusion.Form:Button>
                                    </Neos.Fusion.Form:Form>
                                </div>
                            </div>
                            <div class="neos-modal-backdrop neos-in"></div>
                        </div>

                    </td>
                </tr>
            </Neos.Fusion:Loop>
            </tbody>
        </table>

        <div class="neos-control-group">
            <Neos.Fusion:Link.Action href.action="index" class="neos-button">
                {I18n.translate('showGlossary.backToList', 'Back to list', [], 'Modules', 'Sitegeist.LostInTranslation')}
            </Neos.Fusion:Link.Action>
            <Neos.Fusion:Link.Action href.action="createGlossaryEntry" href.arguments.glossary={glossary} class="neos-button neos-button-primary">
                {I18n.translate('entry.add', 'Add Entry', [], 'Modules', 'Sitegeist.LostInTranslation')}
            </Neos.Fusion:Link.Action>

        </div>
    `
}
